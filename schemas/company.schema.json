{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://order-orchestration-as-code.internal/schemas/company.schema.json",
  "title": "Company (Top-Level)",
  "description": "Top-level tenant/organization. Groups one or more sales channels.",
  "type": "object",
  "required": ["company"],
  "properties": {
    "company": {
      "type": "object",
      "required": ["id", "name", "channels"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "channels": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Relative paths to channel.yaml files."
        }
      }
    }
  }
}
