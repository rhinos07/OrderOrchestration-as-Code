{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://order-orchestration-as-code.internal/schemas/split-reason.schema.json",
  "title": "Split Reason",
  "description": "Catalog entry describing a reason an order can be decomposed into sub-orders. Referenced by split_rule.condition.",
  "type": "object",
  "required": ["id"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "Unique ID, e.g. 'storage_technology_split'"
    },
    "description": { "type": "string" }
  },
  "additionalProperties": true
}
